<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="500"
        Width="350"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/ico/calc_ico.ico">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Border Background="#222"
                CornerRadius="10"
                Padding="10"
                Margin="20"
                VerticalAlignment="Top">
            <TextBlock Name="Display"
                       Text="0 "
                       FontSize="40"
                       Foreground="White"
                       TextAlignment="Right"
                       HorizontalAlignment="Center"
                       Width="290"/>
        </Border>

        <Grid Margin="10,120,10,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Ligne 1 -->
            <Button Content="7" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <Button Content="8" Grid.Row="0" Grid.Column="1" Margin="5"/>
            <Button Content="9" Grid.Row="0" Grid.Column="2" Margin="5"/>

            <!-- Ligne 2 -->
            <Button Content="4" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1" Margin="5"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2" Margin="5"/>

            <!-- Ligne 3 -->
            <Button Content="1" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <Button Content="2" Grid.Row="2" Grid.Column="1" Margin="5"/>
            <Button Content="3" Grid.Row="2" Grid.Column="2" Margin="5"/>

            <!-- Ligne 4 -->
            <Button Content="0" Grid.Row="3" Grid.Column="0" Margin="5"/>
            <Button Content="+" Grid.Row="3" Grid.Column="1" Margin="5"/>
            <Button Content="=" Grid.Row="3" Grid.Column="2" Margin="5"/>
        </Grid>

    </Grid>
</Window>
